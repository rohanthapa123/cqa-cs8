JWT_SECRET=replace-with-a-long-random-string
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/github/callback
FRONTEND_URL=http://localhost:3000
# PostgreSQL (special chars in the password must be URL-encoded, e.g. @ -> %40)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Or SQLite for local dev: sqlite:///./analyzer.db
# Comma-separated emails auto-promoted to admin on startup (optional).
# Alternatively run: python -m backend.create_admin <email> <username> <password>
ADMIN_EMAILS=
